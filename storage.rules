rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 로그인한 사람만, 파일 하나당 10MB까지
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (request.resource == null || request.resource.size < 10 * 1024 * 1024);
    }
  }
}
