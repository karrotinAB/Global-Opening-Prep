rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 계정 레벨: roles/{이메일} 문서의 level
    //   admin(관리자) | pog(POG팀) | vmd(VMD팀) | global(글로벌사업부) | buyer(바이어) | finder(제품 찾기만)
    //   editor = 예전 '편집' 레벨 (모든 편집 가능, 새로 지정은 안 함)
    // 문서가 없는 계정은 'none' = 아무것도 못 봄 (사이트 계정 관리에서 만든 계정만 씀). 'blocked' = 관리자가 접속을 막음
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function level() {
      let p = /databases/$(database)/documents/roles/$(myEmail());
      return exists(p) ? get(p).data.level : 'none';
    }
    function hasLevel(levels) { return signedIn() && level() in levels; }
    // 내부 직원: 초안까지 모두 볼 수 있음. 바이어·매장 계정은 최종본만
    function staff() { return hasLevel(['admin', 'pog', 'vmd', 'global', 'editor']); }
    // 바이어: roles 문서의 prefix(매장코드 앞 4자리)와 storePrefix가 같은 최종본만
    function myPrefix() { return get(/databases/$(database)/documents/roles/$(myEmail())).data.get('prefix', '#'); }
    function anyLevel() { return hasLevel(['admin', 'pog', 'vmd', 'global', 'buyer', 'finder', 'editor']); } // 레벨을 받은(막히지 않은) 계정
    function seeFinal(d) { return anyLevel() && d.status == 'final' && (level() != 'buyer' || d.get('storePrefix', '') == myPrefix()); }

    // 수출서류 아카이빙 사이트(ExportDocumentArchive) 권한: roles 문서의 ex
    //   admin(관리자: 계정 관리) | edit(편집: 사유·추가 제품코드 저장) | view(보기) | 없음·none = 못 씀
    //   Global POG 관리자(level admin)는 이 사이트에서도 관리자. level blocked는 이 사이트도 막힘
    function exLv() {
      let p = /databases/$(database)/documents/roles/$(myEmail());
      return exists(p) ? get(p).data.get('ex', 'none') : 'none';
    }
    function exOk(levels) { return signedIn() && level() != 'blocked' && (level() == 'admin' || exLv() in levels); }
    function exValid(d) { return d.get('ex', 'none') in ['admin', 'edit', 'view', 'none']; }

    match /roles/{email} {
      allow read: if signedIn() && (email == myEmail() || hasLevel(['admin']) || exOk(['admin']));
      allow write: if hasLevel(['admin'])
                   && (request.resource == null || (request.resource.data.level in ['admin', 'pog', 'vmd', 'global', 'buyer', 'finder', 'blocked', 'none']
                       && request.resource.data.get('prefix', '').matches('^[0-9A-Za-z]{0,4}$') && exValid(request.resource.data)));
      // 수출서류 사이트 관리자: ex(이 사이트 권한)만 바꾸거나, Global POG 권한 없는(level none) 계정을 새로 만듦
      allow create: if exOk(['admin']) && request.resource.data.level == 'none' && exValid(request.resource.data)
                    && request.resource.data.keys().hasOnly(['level', 'ex', 'createdAt', 'updatedAt', 'updatedBy']);
      allow update: if exOk(['admin']) && exValid(request.resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ex', 'updatedAt', 'updatedBy']);
    }

    // POG: 만들기는 POG팀, 번역(translations)은 글로벌사업부
    function pogFinal(pogId) { return seeFinal(get(/databases/$(database)/documents/pogs/$(pogId)).data); }
    match /pogs/{pogId} {
      allow read: if staff() || seeFinal(resource.data);
      allow write: if hasLevel(['admin', 'pog', 'editor']);
      match /fixtures/{fxId} {
        allow read: if staff() || pogFinal(pogId);
        allow write: if hasLevel(['admin', 'pog', 'editor']);
      }
      match /translations/{rest=**} {
        allow read: if staff() || pogFinal(pogId);
        allow write: if hasLevel(['admin', 'global', 'editor']);
      }
    }

    // 도면: 편집은 VMD팀, 번역(translations)은 글로벌사업부
    function drawingFinal(id) { return seeFinal(get(/databases/$(database)/documents/drawings/$(id)).data); }
    match /drawings/{drawingId} {
      allow read: if staff() || seeFinal(resource.data);
      allow write: if hasLevel(['admin', 'vmd', 'editor']);
      match /translations/{rest=**} {
        allow read: if staff() || drawingFinal(drawingId);
        allow write: if hasLevel(['admin', 'global', 'editor']);
      }
      match /{sub}/{rest=**} {
        allow read: if staff() || drawingFinal(drawingId);
        allow write: if sub != 'translations' && hasLevel(['admin', 'vmd', 'editor']);
      }
    }

    // 용어 사전: 직원은 보기(엑셀 저장 포함), 편집은 글로벌사업부
    match /glossary/{id} {
      allow read: if staff();
      allow write: if hasLevel(['admin', 'global', 'editor']);
    }
    // 용어 사전 변경 기록: 편집하는 사람만 남기고 읽음. 고치거나 지울 수 없음
    match /glossaryLog/{id} {
      allow read: if hasLevel(['admin', 'global', 'editor']);
      allow create: if hasLevel(['admin', 'global', 'editor']) && request.resource.data.by == myEmail();
    }
    // 매장 등록: 직원은 보기, 등록·수정은 글로벌사업부, 삭제는 관리자만
    match /stores/{id} {
      allow read: if staff();
      allow create, update: if hasLevel(['admin', 'global', 'editor']);
      allow delete: if hasLevel(['admin']); // 매장 삭제는 관리자만
    }
    // 바코드: 문서 ID = 바코드, code = 제품코드, name = 제품명(선택). 제품 찾기에 쓰므로 레벨을 받은 사람 모두 읽음. 올리기는 글로벌사업부
    match /barcodes/{bc} {
      allow read: if anyLevel();
      allow write: if hasLevel(['admin', 'global', 'editor']);
    }
    // POG 담당자 목록
    match /managers/{id} {
      allow read: if staff();
      allow write: if hasLevel(['admin', 'pog', 'editor']);
    }

    // 수출서류 아카이빙: 없는 서류 사유(코드마다) · 추가 제품코드(PDF마다) · 보고서 코드 목록. PDF 파일은 여기 없음 (회사 공용폴더)
    match /exReasons/{id} {
      allow read: if exOk(['admin', 'edit', 'view']);
      allow write: if exOk(['admin', 'edit']);
    }
    match /exExtra/{id} {
      allow read: if exOk(['admin', 'edit', 'view']);
      allow write: if exOk(['admin', 'edit']);
    }
    match /exMeta/{id} {
      allow read: if exOk(['admin', 'edit', 'view']);
      allow write: if exOk(['admin', 'edit']);
    }
  }
}
